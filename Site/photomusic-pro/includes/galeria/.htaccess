# ============================================================
# PROTEÇÃO DA GALERIA DE FOTOS
# ============================================================

# Bloqueia acesso direto
<Files "*">
    Order Allow,Deny
    Deny from all
</Files>

# Impede listagem
Options -Indexes

# Impede execução de scripts
<FilesMatch "\.(php|php5|php7|phtml)$">
    Deny from all
</FilesMatch>

# Impede hotlinking
RewriteEngine On
RewriteCond %{HTTP_REFERER} !^https://photomusic.com.br [NC]
RewriteCond %{HTTP_REFERER} !^https://www.photomusic.com.br [NC]
RewriteCond %{HTTP_REFERER} !^$
RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F,NC,L]
