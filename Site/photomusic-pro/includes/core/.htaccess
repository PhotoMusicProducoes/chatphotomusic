# ============================================================
# PROTEÇÃO DE QR CODES
# ============================================================

# Permite apenas imagens
<FilesMatch "\.(jpg|jpeg|png|gif)$">
    Allow from all
</FilesMatch>

# Bloqueia execução de scripts
<FilesMatch "\.(php|php5|php7|phtml)$">
    Deny from all
</FilesMatch>

Options -Indexes
